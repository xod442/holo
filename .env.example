# Copy to .env and edit. Generate a key with:  python3 -c "import secrets; print(secrets.token_hex(32))"
HOLO_SECRET_KEY=change-me-to-a-long-random-hex

# Corporate DNS resolvers for the container (host networking still uses the
# container's own resolv.conf; without these, internal names like the SMTP
# relay won't resolve). Use your corp resolvers — same as Opal.
HOLO_DNS1=10.0.0.53
HOLO_DNS2=10.0.0.54

# Production behind the HPE edge:
# HOLO_ROOT_PATH=/holo         # the subpath the edge serves (from the browser URL)
# HOLO_PORT=9093               # host port the edge upstream points at (host networking)
# HOLO_COOKIE_SECURE=1         # HTTPS via the edge

# Optional overrides
# HOLO_COOKIE_NAME=holo_session
# HOLO_INVITE_TTL_DAYS=7
# HOLO_ADMIN_USERNAME=admin    # seeded default admin (fresh DB only)
# HOLO_ADMIN_PASSWORD=admin    # must be changed on first login
# HOLO_MANAGER_USERNAME=manager
# HOLO_MANAGER_PASSWORD=manager
# HOLO_ADMIN2_USERNAME=admin-holo  # seeded second admin (same access as admin)
# HOLO_ADMIN2_PASSWORD=admin-holo  # must be changed on first login

# Single sign-on hand-off with FOCUS (same host, separate app on port 9094).
# Works both ways: incoming (FOCUS -> HOLO) and outgoing (the "FOCUS" nav
# button, HOLO -> FOCUS). Empty = both directions disabled (buttons hidden,
# routes reject everything). Must be set to the EXACT SAME value in FOCUS's
# own .env — this is a shared secret between the two apps, NOT either app's
# own HOLO_SECRET_KEY/FOCUS_SECRET_KEY.
# SSO_SHARED_SECRET=change-me-to-a-long-random-value-matching-focus
# FOCUS_BASE_URL=http://localhost:9094   # must be reachable by the BROWSER, not just this container
